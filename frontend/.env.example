# Singgah-sana Frontend Environment Configuration Example
# Salin berkas ini ke .env.local untuk konfigurasi lokal

# Alamat server backend Singgah-sana (server-only, default: http://127.0.0.1:5000/api)
API_BASE_URL=http://127.0.0.1:5000/api

# Akses halaman katalog komponen (/ui) pada environment produksi (default: false)
UI_CATALOG_ENABLED=false
