# Singgah-sana Frontend Environment Configuration Example
# Salin berkas ini ke .env.local untuk konfigurasi lokal

# Alamat server backend Singgah-sana (server-only, default: http://127.0.0.1:5000/api)
API_BASE_URL=http://127.0.0.1:5000/api

# Origin kanonis aplikasi frontend untuk validasi Same-Origin CSRF dan proxy gateway (default: http://localhost:3000)
APP_ORIGIN=http://localhost:3000

# Akses halaman katalog komponen (/ui) pada environment produksi (default: false)
UI_CATALOG_ENABLED=false

# Konfigurasi layer ubin peta interaktif OpenStreetMap / Leaflet (src/lib/mapConfig.ts)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> kontributor'
